with
     "lace",
     "opengl",
     "collada",
     "physics",
     "lace_shared";

project GEL
is
   for Create_Missing_Dirs use "True";

   for Object_Dir  use Lace_shared.object_Dir;

   for Source_Dirs use ("../source",
                        "../source/remote",
                        "../source/interface",
                        "../source/concrete",
                        "../source/dolly",
                        "../source/forge",
                        "../source/human",
                        "../source/joint",
                        "../source/applet",
                        "../source/applet/distributed",
                        "../source/terrain",
                        "../source/world");

   package Builder  renames Lace_shared.Builder;
   package Compiler renames Lace_shared.Compiler;

end GEL;
