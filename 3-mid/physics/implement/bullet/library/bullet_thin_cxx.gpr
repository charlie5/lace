with
     "bullet_thin_c",
     "lace_shared";

project Bullet_Thin_Cxx
is
   for Languages   use ("c++");
   for Source_Dirs use ("../source/thin");
   for Object_Dir  use Lace_shared.object_Dir;

   package Naming is
      for Spec_Suffix ("c++") use ".h";
      for Body_Suffix ("c++") use ".cxx";
   end Naming;

   package Compiler is
      for Default_Switches ("c++") use ("-g",
                                        "-I" & project'Project_Dir & "../../c_math/source/c",
                                        "-Wno-return-type-c-linkage");
   end Compiler;

   package Builder  renames Lace_shared.Builder;

end Bullet_Thin_Cxx;
