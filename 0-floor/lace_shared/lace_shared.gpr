abstract
project lace_Shared
is
   -- Scenario Variables
   --

   type OS_type           is ("Windows_NT", "Linux");
   type build_Mode_type   is ("debug", "fast", "profile", "small");

   lace_OS           : OS_type           := external ("Lace_OS",                     -- Windows sets 'OS' to "Windows_NT" natively, so
                                                       external ("OS", "Linux"));    -- only a cross build need set 'Lace_OS'.
   lace_build_Mode   : build_Mode_type   := external ("Lace_Build_Mode", "debug");


   -- Each build mode keeps its own objects, so switching modes forces no recompiles.
   --
   object_Dir   := "build/" & lace_build_Mode;


   -- Declare various options.
   --

   binder_Options   := ();
   linker_Options   := ();

   style_Options    := ("-gnaty3",     -- Check 3-space indentation.
                        "-gnatyb",     -- Check no blanks at end of lines.
                        "-gnatye",     -- Check that labels on end statements (ending subprograms), and on exit statements (exiting named loops), are present.
                        "-gnatyf",     -- Check no ff/vtabs.
                        "-gnatyh",     -- Check no htabs.
                        "-gnatyi",     -- Check if-then layout.
                        "-gnatyk",     -- Check keyword casings.
                        "-gnatyl",     -- Check that layout follows the reference manual style.
                        "-gnatyO",     -- Check that overriding subprograms are explicitly marked as such.
                        "-gnatyx");    -- Check no extra parens.

   compiler_Options :=   ("-gnat2022",
                          "-gnatwa",
                          "-fno-strict-aliasing")
                       & style_Options;

   fast_Options     := ("-O3",
                        "-gnatn",
                        "-funroll-loops",
                        "-ftracer");

   small_Options    := ("-Os",
                        "-ffunction-sections",     -- Give each subprogram and object its own section, so the
                        "-fdata-sections");        -- linker can discard those which are unreferenced.


   -- Modify options to cater for the build mode.
   --

   case lace_build_Mode
   is
      when "debug" =>
         binder_Options   := binder_Options   & "-Es";
         compiler_Options := compiler_Options & "-O0"
                                              & "-gnata"
                                              & "-gnateE"                -- Extra debug info in 'constraint_Error' messages.
                                              & "-fstack-check"
                                              & "-g"
                                              & "-gnatVa"
                                              & ("-gnatec=" & Project'Project_Dir & "debug.pra");   -- Initialize_Scalars ~ as a compiler switch (rather than
                                                                                                    -- Builder'Global_Configuration_Pragmas, which gprbuild only
                                                                                                    -- honours in the main project) so every project gets it.

      when "fast" =>
         compiler_Options := compiler_Options & fast_Options;

      when "profile" =>
         compiler_Options := compiler_Options & fast_Options       -- As "fast", but keep debug info and frame
                                              & "-g"               -- pointers so the profiler can see call chains.
                                              & "-fno-omit-frame-pointer";

      when "small" =>
         compiler_Options := compiler_Options & small_Options;
         linker_Options   := linker_Options   & "-Wl,--gc-sections";
   end case;


   -- Modify options to cater for the operating system.
   --

   case lace_OS
   is
      when "Linux" =>
         binder_Options   := binder_Options   & "-static";

      when "Windows_NT" =>
         null;
   end case;


   -- Define the packages.
   --

   package Builder
   is
      for Default_Switches ("ada") use ("-j0");
   end Builder;


   package Compiler
   is
      for Default_Switches ("ada") use compiler_Options;
   end Compiler;


   package Binder
   is
      for Default_Switches ("ada") use binder_Options;
   end Binder;


   package Linker
   is
      for Linker_Options use linker_Options;   -- Reaches the link of every importing main, with no need to rename this package.
   end Linker;


end lace_Shared;
