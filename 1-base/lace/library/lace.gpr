with
     "lace_shared";


-- Not a library project: lace.Events has 'remote_Types' units, which a PolyORB partition must compile against
-- PolyORB's own System.Partition_Interface, so 'po_gnatdist' has to recompile them itself (see the DSA demos).
--
project Lace
is
   for Create_Missing_Dirs use "True";

   for Object_Dir  use Lace_shared.object_Dir;

   for Source_Dirs use ("../source",
                        "../source/containers",
                        "../source/dice",
                        "../source/events/**",
                        "../source/jobs",
                        "../source/strings",
                        "../source/text/**");

   package Builder  renames Lace_shared.Builder;
   package Compiler renames Lace_shared.Compiler;
   package Binder   renames Lace_shared.Binder;

end Lace;
