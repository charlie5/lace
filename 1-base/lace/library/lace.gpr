with
     "lace_shared";


library
project Lace
is
   for Create_Missing_Dirs use "True";

   for Object_Dir   use Lace_shared.object_Dir;
   for Library_Dir  use "lib/" & Lace_shared.lace_build_Mode;   -- Per build mode, like the objects, so switching modes never links a stale archive.
   for Library_Name use "lace";

   for Source_Dirs use ("../source",
                        "../source/containers",
                        "../source/dice",
                        "../source/events/**",
                        "../source/jobs",
                        "../source/strings",
                        "../source/text/**");

   package Builder  renames Lace_shared.Builder;
   package Compiler renames Lace_shared.Compiler;
   package Binder   renames Lace_shared.Binder;

end Lace;
