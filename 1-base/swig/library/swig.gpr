with
     "lace_shared";

project Swig
is
   for Source_Dirs use (".", "../source");
   for Object_Dir  use Lace_shared.object_Dir;

   package Builder is
      for Default_Switches ("ada") use ("-g");
   end Builder;

   package Compiler is
      for Default_Switches ("ada") use ("-gnato", "-fstack-check", "-g", "-gnata");
   end Compiler;

   package Binder is
      for Default_Switches ("ada") use ("-E");
   end Binder;

end Swig;

